# Meta Model API key (server-side only; never exposed to the browser)
MODEL_API_KEY=

# Meta's open weights (Muse Spark Open), optional: answers the reads Muse Spark is slow on, and lets a visitor send
# every read to it ("Read on open weights only"). Baseten's Model APIs by default; OPEN_API_BASE points at any server
# that speaks chat completions with these weights, and OPEN_MODEL_ID names the model there.
BASETEN_API_KEY=
# OPEN_API_BASE=https://inference.baseten.co/v1
# OPEN_MODEL_ID=meta-models/muse-spark-open
# READ_FIRST=meta        # meta (default): Muse Spark first · open: the open weights first · meta-only: Meta's API alone
# OPEN_WEIGHTS=off       # set the open weights aside without removing the key
